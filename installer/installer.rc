1 VERSIONINFO
FILEVERSION 1,0,0,0      // Версия файла (major,minor,patch,build)
PRODUCTVERSION 1,0,0,0   // Версия продукта (обычно совпадает с FILEVERSION)
FILEOS 0x40004           // 0x40004 = Windows NT (0x00040000) + GUI-приложение (0x00000004)
FILETYPE 0x1             // 0x1 = VFT_APP (обычное приложение, не драйвер, не DLL)
{
	BLOCK "StringFileInfo"
	{
		BLOCK "040904B0" // Язык и кодировка: 0x0409=Английский (США), 0x04B0=Unicode (UTF-16)
		{
			VALUE "CompanyName", "Qirashi"
			VALUE "FileDescription", "CLI installer for the DVPL converter."
			VALUE "FileVersion", "1,0,0,0"
			VALUE "InternalName", "installer.exe"
			VALUE "LegalCopyright", "Copyright (c) 2026 Qirashi"
			VALUE "OriginalFilename", "installer.exe"
			VALUE "ProductName", "DvplGo"
			VALUE "ProductVersion", "1,0,0,0"
		}
	}
	BLOCK "VarFileInfo"
	{
		VALUE "Translation", 0x0409, 0x04B0
	}
}